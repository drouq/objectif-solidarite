# Uploaded files: never run as code.
Options -Indexes -ExecCGI
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .cgi .pl .py .sh
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
</IfModule>
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|cgi|pl|py|sh|htaccess|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
